# ── Servidor ─────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# ════════════════════════════════════════════════════════════════════
# Prisma Database
# ════════════════════════════════════════════════════════════════════
DB_HOST=localhost
DB_PORT=5432
DB_NAME=tickets_db
DB_USER=ticketsuser
DB_PASSWORD=password
DATABASE_URL=postgresql://ticketsuser:password@localhost:5432/tickets_db

# ── Auth ─────────────────────────────────────────────────────────────
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=1h
JWT_REFRESH_SECRET=change-me-too-a-different-long-random-string
JWT_REFRESH_EXPIRES_IN=7d

# Clave AES-256 (32 bytes en hex = 64 caracteres) para shared/utils/encryption.ts.
# Generar con: openssl rand -hex 32
ENCRYPTION_KEY=change-me-to-a-64-char-hex-string-0000000000000000000000000000

# Cloudflare Turnstile (gratis, dashboard.cloudflare.com → Turnstile) — el
# secret key va acá; el site key (público) va en frontend/.env.local como
# VITE_TURNSTILE_SITE_KEY. Sin esto, el bot no puede crear tickets sin NIT o
# con NIT no registrado (falla cerrado a propósito, ver turnstile.service.ts).
TURNSTILE_SECRET_KEY=your-turnstile-secret-key

# ── Backups automáticos (pg_dump programado) ────────────────────────
BACKUP_ENABLED=false
BACKUP_CRON=0 3 * * *
BACKUP_DIR=./backups

# ── Remotely ─────────────────────────────────────────────────────────
REMOTELY_SERVER_URL=https://remotely.example.com
REMOTELY_API_KEY=your-remotely-api-key
REMOTELY_ORGANIZATION_ID=your-org-id

# ── CORS ─────────────────────────────────────────────────────────────
CORS_ORIGIN=http://localhost:5173
# URL pública del frontend — usada para armar links que se mandan por email
# (ej. aprobación de cotizaciones). Separado de CORS_ORIGIN porque ese puede
# ser una lista de varios orígenes.
FRONTEND_URL=http://localhost:5173
# URL pública por la que ESTE backend es alcanzable desde un equipo cliente
# recién instalado (no un navegador autenticado) — usada para reportar el
# resultado del endurecimiento del agente de Remotely. Vacío = ese paso de
# reporte se omite (el endurecimiento en sí igual se aplica).
API_PUBLIC_URL=

# ── Rate limiting ────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# ── Métricas (Prometheus) ────────────────────────────────────────────
# Token compartido requerido en el header `x-metrics-token` para leer
# /metrics. Vacío = el endpoint queda deshabilitado (falla cerrado, mismo
# criterio que Turnstile) — generar con: openssl rand -hex 32
METRICS_TOKEN=

# ── Email (envío de actas, cotizaciones, notificaciones) ────────────
# Resend (resend.com) — usado por defecto salvo que se configure SMTP propio
# desde Configuración → Email (ver features/settings, send-email.job.ts).
RESEND_API_KEY=your-resend-api-key
EMAIL_FROM=onboarding@resend.dev

# ── Redis (cache, pub/sub, colas) ────────────────────────────────────
REDIS_URL=redis://:redis123@localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redis123
REDIS_DB=0

# ── Cache TTLs (segundos) ────────────────────────────────────────────
CACHE_TTL=3600
CACHE_DEVICES_TTL=300
CACHE_TICKETS_TTL=600

# ── Colas (Bull) ─────────────────────────────────────────────────────
QUEUE_NAME=tickets-queue
QUEUE_WORKERS=2
QUEUE_CONCURRENCY=5
