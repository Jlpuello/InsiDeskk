# Variables del stack (docker-compose.yml). Copiar a `.env` (junto al compose) o
# cargarlas en Portainer → Stacks → Environment variables. NUNCA commitear el .env.

# ── Obligatorias ─────────────────────────────────────────────────────
# Ruta ABSOLUTA de esta carpeta en el host (en Portainer los paths relativos no
# se resuelven). Linux: /opt/insidesk — Docker Desktop/Windows: D:/Proyectos/InsiDesk
PROJECT_DIR=/opt/insidesk

# Generar cada una con: openssl rand -hex 32   (ENCRYPTION_KEY: exactamente 64 hex)
JWT_SECRET=
JWT_REFRESH_SECRET=
ENCRYPTION_KEY=

# OJO: DB_PASSWORD solo se aplica al crear el volumen de Postgres la primera vez.
# Si la base ya existe (volumen insidesk_postgres_data) y la querés cambiar:
#   docker exec tickets_postgres psql -U ticketsuser -c "ALTER USER ticketsuser PASSWORD 'nueva'"
DB_PASSWORD=
REDIS_PASSWORD=

# URL pública con la que los usuarios abren la app (incluye https:// si hay TLS)
CORS_ORIGIN=https://soporte.tuempresa.com
FRONTEND_URL=https://soporte.tuempresa.com

# ── Opcionales ───────────────────────────────────────────────────────
APP_PORT=80
# true SOLO si se sirve por HTTPS (cookies de sesión con flag Secure)
COOKIE_SECURE=false
# 1 = solo el nginx del contenedor; 2 si hay otro proxy delante (Traefik/NPM/Cloudflare)
TRUST_PROXY=1

DB_NAME=tickets_db
DB_USER=ticketsuser

# Cloudflare Turnstile (secret = backend, site key = se hornea en el frontend)
TURNSTILE_SECRET_KEY=
VITE_TURNSTILE_SITE_KEY=

# Token para leer /metrics (openssl rand -hex 32). Vacío = /metrics deshabilitado.
METRICS_TOKEN=

# Email por Resend (o configurar SMTP desde la app: Configuración → Email)
RESEND_API_KEY=
EMAIL_FROM=onboarding@resend.dev

# Remotely
REMOTELY_SERVER_URL=
REMOTELY_API_KEY=
REMOTELY_ORGANIZATION_ID=
VITE_REMOTELY_URL=
API_PUBLIC_URL=

# Backups (pg_dump diario a las 3am, se conservan 14 días)
BACKUP_ENABLED=true
BACKUP_CRON=0 3 * * *
BACKUP_RETENTION_DAYS=14

RATE_LIMIT_MAX=300
